# Copy this file to .env.local and fill in your own values.
# Supabase dashboard -> your project -> Connect
#
# The publishable key (sb_publishable_...) goes in
# NEXT_PUBLIC_SUPABASE_ANON_KEY. Older projects call it the anon key.
#
# Add these SAME variables in Vercel:
#   Project -> Settings -> Environment Variables -> then redeploy.
#
# .env.local is gitignored. Never commit real values.
# Never add the service_role key or any sb_secret_ key to this project.
# Both bypass Row Level Security and would let anyone with them read all
# your data.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Optional: ID verification with Didit (a real ID + selfie check) -----
# SERVER-ONLY. Never prefix these with NEXT_PUBLIC_. Add the same values in
# Vercel -> Settings -> Environment Variables.
# KYC_RECORD_SECRET: any long random string. Store the SAME value in
# Supabase Vault as "kyc_record_secret" (see supabase/sql/028 notes).
KYC_RECORD_SECRET=
DIDIT_API_KEY=
DIDIT_WORKFLOW_ID=
DIDIT_WEBHOOK_SECRET=
